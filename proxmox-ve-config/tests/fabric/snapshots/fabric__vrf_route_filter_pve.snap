---
source: proxmox-ve-config/tests/fabric/main.rs
expression: output
---
!
router bgp 65001 vrf vrf_blue
 bgp router-id 10.1.0.1
 no bgp default ipv4-unicast
 neighbor bgpblue peer-group
 neighbor bgpblue remote-as external
 neighbor ens19 interface peer-group bgpblue
 !
 address-family ipv4 unicast
  network 10.1.0.1/32
  neighbor bgpblue activate
  neighbor bgpblue soft-reconfiguration inbound
  neighbor bgpblue route-map pve_bgp_bgpblue_in in
 exit-address-family
 !
 address-family ipv6 unicast
  network fd00:10::1/128
  neighbor bgpblue activate
  neighbor bgpblue soft-reconfiguration inbound
  neighbor bgpblue route-map pve_bgp6_bgpblue_in in
 exit-address-family
exit
!
ip prefix-list blue-allowed seq 10 permit 10.1.0.0/24 le 32
ip prefix-list blue-allowed seq 20 permit 192.0.2.0/24
ipv6 prefix-list blue-allowed seq 30 permit fd00:10::/64 le 128
!
ip prefix-list red-allowed seq 10 permit 10.0.0.0/24 le 32
ip prefix-list red-allowed seq 20 permit 198.51.100.0/24
!
router ospf vrf vrf_red
 ospf router-id 10.0.0.1
exit
!
interface dummy_ospfred vrf vrf_red
 ip ospf area 0
 ip ospf passive
exit
!
interface ens18 vrf vrf_red
 ip ospf area 0
 ip ospf network point-to-point
exit
!
route-map pve_bgp6_bgpblue_in permit 10
 match ipv6 address prefix-list blue-allowed
exit
!
route-map pve_bgp6_vrf_blue permit 110
 match ipv6 address prefix-list blue-allowed
 set src fd00:10::1
exit
!
route-map pve_bgp6_vrf_blue permit 65535
exit
!
route-map pve_bgp_bgpblue_in permit 10
 match ip address prefix-list blue-allowed
exit
!
route-map pve_bgp_vrf_blue permit 100
 match ip address prefix-list blue-allowed
 set src 10.1.0.1
exit
!
route-map pve_bgp_vrf_blue permit 65535
exit
!
route-map pve_ospf_vrf_red permit 120
 match ip address prefix-list red-allowed
 set src 10.0.0.1
exit
!
vrf vrf_blue
 ip protocol bgp route-map pve_bgp_vrf_blue
 ipv6 protocol bgp route-map pve_bgp6_vrf_blue
exit-vrf
!
vrf vrf_red
 ip protocol ospf route-map pve_ospf_vrf_red
exit-vrf
